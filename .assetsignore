# Wrangler reads this from the assets directory (= repo root). Everything NOT excluded here is
# published on the client's live business domain. Deny by TYPE, not just by the filename that bit you.
# After EVERY deploy: for f in DEPLOY.md ROOM.json BRIEF.md wrangler.toml data/menu.json migrations/0001_schema.sql; do
#   curl -s -o /dev/null -w "$f %{http_code}\n" "https://www.oudkempeneetcafe.nl/$f"; done  → every one must be 404.
*.md
*.json
*.sql
*.py
*.toml
.assetsignore
.gitignore
.github/
.git/
# The ordering backend: source, migrations, tools, tests, seed data — never www assets.
src/
migrations/
tools/
tests/
data/
# The ordering app itself (own hostname, own Worker). Q28 makes /bestellen on www a REDIRECT to
# the subdomain, so publishing these here would contradict a ruling, not merely be untidy.
ordering/
